{
  "name": "@openpedd/reader",
  "version": "0.7.0",
  "description": "Reads an OpenPEDD spec: parses it and reports what is broken, reads the Business Map, reads and writes a change's definition, numbers changes, renders the framework map, and makes and renders every project view",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPEDD/openpedd.git",
    "directory": "packages/reader"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./files": "./src/files.mjs",
    "./markdown": "./src/markdown.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "openpedd-reader": "./bin/openpedd-reader.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "elkjs": "0.11.1"
  }
}
