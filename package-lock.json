{
  "name": "openpedd",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "openpedd",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@openpedd/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@openpedd/reader": {
      "resolved": "packages/reader",
      "link": true
    },
    "packages/cli": {
      "name": "@openpedd/cli",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@openpedd/reader": "0.2.0"
      },
      "bin": {
        "pedd": "bin/pedd.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/reader": {
      "name": "@openpedd/reader",
      "version": "0.2.0",
      "license": "Apache-2.0",
      "bin": {
        "openpedd-reader": "bin/openpedd-reader.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
